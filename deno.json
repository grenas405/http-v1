{
  "name": "@pedro/http-v1",
  "version": "0.1.0",
  "exports": {
    ".": "./src/http/mod.ts",
    "./cloudflare": "./src/adapters/cloudflare/mod.ts"
  },
  "imports": {
    "zod": "jsr:@zod/zod@^4.6.5"
  },
  "tasks": {
    "check": "deno check src tests",
    "test": "deno test",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "bundle": "deno bundle --platform=browser --format=esm --minify --output=dist/worker.js src/worker.ts",
    "dev": "npx wrangler@4 dev",
    "deploy": "npx wrangler@4 deploy",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"]
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["dist/"]
  },
  "lint": {
    "exclude": ["dist/"]
  },
  "exclude": ["dist/", ".wrangler/"]
}
